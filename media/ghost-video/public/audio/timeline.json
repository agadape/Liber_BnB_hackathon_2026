[
  {
    "text": "The sandwich is ready.",
    "file": "audio/story-0.wav",
    "seconds": 1.9,
    "rate": 1.1568047337278102,
    "start": 0.45,
    "end": 2.0924552429667527
  },
  {
    "text": "Your phone is at one percent.",
    "file": "audio/story-1.wav",
    "seconds": 2.175,
    "rate": 1.1568047337278102,
    "start": 2.2424552429667526,
    "end": 4.122634271099745
  },
  {
    "text": "Of course it is.",
    "file": "audio/story-2.wav",
    "seconds": 1.65,
    "rate": 1.1568047337278102,
    "start": 4.272634271099745,
    "end": 5.6989769820971885
  },
  {
    "text": "What if you could prepare a payment permission before your battery gives up?",
    "file": "audio/story-3.wav",
    "seconds": 4.05,
    "rate": 1.1568047337278102,
    "start": 5.848976982097189,
    "end": 9.350000000000003
  },
  {
    "text": "Meet Liber, Ghost Protocol.",
    "file": "audio/intro-0.wav",
    "seconds": 2.425,
    "rate": 1.0592592592592591,
    "start": 10.45,
    "end": 12.739335664335664
  },
  {
    "text": "A prefunded payment permission that can leave your phone, and travel on paper.",
    "file": "audio/intro-1.wav",
    "seconds": 4.725,
    "rate": 1.0592592592592591,
    "start": 12.889335664335665,
    "end": 17.35
  },
  {
    "text": "Choose one merchant, one amount, and an expiry.",
    "file": "audio/rules-0.wav",
    "seconds": 3.225,
    "rate": 1.1555023923444974,
    "start": 18.45,
    "end": 21.240993788819875
  },
  {
    "text": "Sign that exact permission, then reserve the tokens.",
    "file": "audio/rules-1.wav",
    "seconds": 3.675,
    "rate": 1.1555023923444974,
    "start": 21.390993788819873,
    "end": 24.57142857142857
  },
  {
    "text": "The contract enforces the limits.",
    "file": "audio/rules-2.wav",
    "seconds": 2.55,
    "rate": 1.1555023923444974,
    "start": 24.721428571428568,
    "end": 26.928260869565214
  },
  {
    "text": "The paper carries the authorization.",
    "file": "audio/rules-3.wav",
    "seconds": 2.625,
    "rate": 1.1555023923444974,
    "start": 27.078260869565213,
    "end": 29.349999999999994
  },
  {
    "text": "Here is the live workspace.",
    "file": "audio/prepare-0.wav",
    "seconds": 2.15,
    "rate": 1.1204819277108433,
    "start": 30.45,
    "end": 32.368817204301074
  },
  {
    "text": "Review the recipient and expiry before signing.",
    "file": "audio/prepare-1.wav",
    "seconds": 3.4,
    "rate": 1.1204819277108433,
    "start": 32.51881720430107,
    "end": 35.55322580645161
  },
  {
    "text": "Preparation requires your wallet and an internet connection.",
    "file": "audio/prepare-2.wav",
    "seconds": 4.05,
    "rate": 1.1204819277108433,
    "start": 35.703225806451606,
    "end": 39.317741935483866
  },
  {
    "text": "Only after the reserve is confirmed should you hand over the voucher.",
    "file": "audio/prepare-3.wav",
    "seconds": 4.35,
    "rate": 1.1204819277108433,
    "start": 39.467741935483865,
    "end": 43.349999999999994
  },
  {
    "text": "The buyer can leave the device behind.",
    "file": "audio/handover-0.wav",
    "seconds": 2.6,
    "rate": 1.0813953488372094,
    "start": 44.45,
    "end": 46.85430107526882
  },
  {
    "text": "The merchant scans the voucher and claims with the named wallet.",
    "file": "audio/handover-1.wav",
    "seconds": 3.95,
    "rate": 1.0813953488372094,
    "start": 47.00430107526882,
    "end": 50.65698924731183
  },
  {
    "text": "The merchant still needs internet and gas.",
    "file": "audio/handover-2.wav",
    "seconds": 2.75,
    "rate": 1.0813953488372094,
    "start": 50.806989247311826,
    "end": 53.349999999999994
  },
  {
    "text": "This public testnet receipt shows five mock tokens transferred to the merchant.",
